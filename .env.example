# Gemini API key (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Postgres connection string used by server/prisma
DATABASE_URL=postgresql://tripwire:tripwire@localhost:5432/tripwire

# Server port
PORT=4000

# Deployed client origin. When set, CORS is pinned to it and the preflight is
# cached; leave unset for local dev (any origin allowed). e.g. https://tripwire.zone.id
CLIENT_ORIGIN=

# Vite dev proxy target for the client (optional, defaults to http://localhost:4000)
VITE_API_URL=http://localhost:4000
